QMainWindow {
    background-color: rgb(31, 34, 42);
    color: white;
}

QFrame {
    border: none;
}

QFrame#panelLeft {
    background-color: rgb(207, 24, 34);
    border: none;
}

QFrame#panelRight {
    background-color: rgb(31, 34, 42);
    border: none;
}

QFrame#panel1 {
    background-color: rgb(31, 34, 42);
    border: none;
}

QLabel {
    color: white;
    background-color: transparent;
}

QLabel#txtTitle {
    font-family: "Century Gothic";
    font-size: 20pt;
    font-weight: normal;
    color: white;
}

QLabel#txtSubTitle {
    font-family: "Century Gothic";
    font-size: 12pt;
    font-weight: bold;
    color: white;
}

QLabel#txtStatus {
    font-family: "Century Gothic";
    font-size: 18pt;
    color: rgb(238, 26, 74);
}

QLabel#txtLogTitle {
    font-family: "Century Gothic";
    font-size: 12pt;
    color: white;
}

QLabel#txtTerms {
    font-family: "Century Gothic";
    font-size: 12pt;
    color: white;
}

QPushButton {
    font-family: "Century Gothic";
    font-size: 12pt;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
}

QPushButton#btnInstall {
    background-color: rgb(207, 24, 34);
    color: white;
}

QPushButton#btnInstall:hover {
    background-color: rgb(227, 44, 54);
}

QPushButton#btnInstall:pressed {
    background-color: rgb(187, 4, 14);
}

QPushButton#btnInstall:disabled {
    background-color: rgb(100, 100, 100);
    color: rgb(150, 150, 150);
}

QPushButton#btnUninstall {
    background-color: black;
    color: white;
}

QPushButton#btnUninstall:hover {
    background-color: rgb(40, 40, 40);
}

QPushButton#btnUninstall:pressed {
    background-color: rgb(20, 20, 20);
}

QPushButton#btnUninstall:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

QTextEdit {
    background-color: rgb(20, 24, 29);
    color: rgb(134, 135, 135);
    border: none;
    font-family: "Arial";
    font-size: 8pt;
    font-weight: bold;
    selection-background-color: rgb(207, 24, 34);
}

QProgressBar {
    border: 5px solid rgb(211, 211, 211);
    border-radius: 96px;
    background-color: rgb(31, 34, 42);
    text-align: center;
    font-size: 26pt;
    color: white;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: rgb(207, 24, 34);
    border-radius: 91px;
}

QCheckBox {
    color: white;
    font-family: "Century Gothic";
    font-size: 12pt;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgb(132, 135, 140);
    border-radius: 3px;
    background-color: transparent;
}

QCheckBox::indicator:checked {
    background-color: rgb(238, 26, 74);
    border: 2px solid rgb(238, 26, 74);
}

QCheckBox::indicator:unchecked {
    background-color: rgb(132, 135, 140);
    border: 2px solid rgb(132, 135, 140);
}

QCheckBox::indicator:disabled {
    background-color: rgb(100, 100, 100);
    border: 2px solid rgb(100, 100, 100);
}

QScrollBar:vertical {
    background-color: rgb(31, 34, 42);
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: rgb(207, 24, 34);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgb(227, 44, 54);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: rgb(31, 34, 42);
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: rgb(207, 24, 34);
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgb(227, 44, 54);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}
